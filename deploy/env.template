# Open Archiver — bare-metal .env template
# Rendered by deploy/install.sh; @@PLACEHOLDERS@@ are replaced at install time.
# The deployed file lives at /srv/openarchiver/.env, mode 600, owner openarchiver.
# NOTE: values must stay both dotenv-parseable AND POSIX-shell-sourceable
# (deploy/bin/oa-run.sh sources this file). No $VAR references — write values
# out explicitly (dotenv does not expand them, the shell would).

# --- Application Settings ---
NODE_ENV=production
PORT_BACKEND=4000
PORT_FRONTEND=3000
# Public URL. ORIGIN must equal APP_URL or SvelteKit rejects form POSTs (CSRF).
APP_URL=https://@@ARCHIVE_DOMAIN@@
ORIGIN=https://@@ARCHIVE_DOMAIN@@
SYNC_FREQUENCY='* * * * *'
ALL_INCLUSIVE_ARCHIVE=false
INGESTION_WORKER_CONCURRENCY=5

# --- PostgreSQL (local, 127.0.0.1) ---
POSTGRES_DB=open_archive
POSTGRES_USER=openarchiver
POSTGRES_PASSWORD=@@POSTGRES_PASSWORD@@
DATABASE_URL="postgresql://openarchiver:@@POSTGRES_PASSWORD@@@127.0.0.1:5432/open_archive"

# --- Meilisearch (local, 127.0.0.1) ---
MEILI_MASTER_KEY=@@MEILI_MASTER_KEY@@
MEILI_HOST=http://127.0.0.1:7700
MEILI_INDEXING_BATCH=500

# --- Valkey (local, 127.0.0.1) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=@@REDIS_PASSWORD@@
REDIS_TLS_ENABLED=false
# REDIS_USER intentionally unset — default user + requirepass

# --- Storage ---
STORAGE_TYPE=local
BODY_SIZE_LIMIT=100M
STORAGE_LOCAL_ROOT_PATH=/var/data/open-archiver
# AES-256 encryption of archived files at rest
STORAGE_ENCRYPTION_KEY=@@STORAGE_ENCRYPTION_KEY@@

# --- Security & Authentication ---
ENABLE_DELETION=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
JWT_SECRET=@@JWT_SECRET@@
JWT_EXPIRES_IN="7d"
# DB field encryption (ingestion source credentials)
ENCRYPTION_KEY=@@ENCRYPTION_KEY@@

# --- Text extraction ---
# TIKA_URL intentionally unset — bundled JS parsers are used (see BARE-METAL-PLAN.md §4)
PDF_PARSE_TIMEOUT_MS=20000
